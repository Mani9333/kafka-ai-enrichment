# Copy to .env and edit. Defaults run fully offline: no keys, no cloud.
# The LLM enrichment defaults to a deterministic, rule-based mock so the whole
# pipeline works with zero configuration.

# --- LLM provider (enrichment) ---
LLM_PROVIDER=mock            # mock | openai | anthropic | ollama

# --- Kafka ---
KAFKA_BOOTSTRAP=localhost:9092
TOPIC_IN=events.in
TOPIC_OUT=events.out
TOPIC_DLQ=events.dlq
CONSUMER_GROUP=enrichment-workers

# --- Consumer tuning ---
BATCH_SIZE=100               # max records pulled per poll
POLL_TIMEOUT_MS=1000         # how long a poll blocks waiting for records
MAX_RETRIES=3               # retries for a transient enrichment failure
RETRY_BACKOFF_MS=200         # base backoff; doubles each attempt (200, 400, 800)

# --- Dashboard ---
DASHBOARD_PORT=8101

# --- Real LLM providers (optional; only read when LLM_PROVIDER != mock) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#
# LLM_PROVIDER=ollama          # local & free: https://ollama.com
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434
